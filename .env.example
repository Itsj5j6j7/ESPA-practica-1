# Copia a .env y rellena. Nunca subas .env.

# IA (OpenRouter, API compatible con OpenAI: https://openrouter.ai/api/v1)
AI_API_KEY=
AI_MODEL=

# Clerk
CLERK_SECRET_KEY=
# Orígenes desde los que se abre la SPA, separados por comas (en EC2: http://IP_EC2)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=
